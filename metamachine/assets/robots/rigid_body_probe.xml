<mujoco model="rigid_body_probe">
  <compiler angle="radian"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="Euler"/>
  <worldbody>
    <geom name="floor" type="plane" size="10 10 0.1" friction="0.8 0 0"/>
    <body name="torso" pos="0 0 2">
      <freejoint name="root"/>
      <inertial pos="0.02 0 0" mass="2" diaginertia="0.02 0.03 0.04"/>
      <geom name="torso_geom" type="box" size="0.12 0.08 0.06" friction="0.8 0 0"/>
      <body name="arm" pos="0.15 0 0">
        <joint name="hinge" type="hinge" axis="0 1 0" range="-1.2 1.2" damping="0.03" armature="0.01"/>
        <inertial pos="0.12 0 0" mass="0.5" diaginertia="0.001 0.004 0.004"/>
        <geom name="arm_geom" type="capsule" fromto="0 0 0 0.24 0 0" size="0.025" friction="0.8 0 0"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="hinge_motor" joint="hinge" gear="2" ctrllimited="true" ctrlrange="-1 1" forcelimited="true" forcerange="-0.8 0.8"/>
  </actuator>
</mujoco>
